{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "/scripts/build-k.sh",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }, 
        {
            "label": "(Needed) build-fs",
            "type": "shell",
            "command": "/scripts/build-fs.sh",
            "problemMatcher": [],
            "group": "build",
        }, 
        {
            "label": "(normal) Start Kernel in QEMU",
            "type": "shell",
            "command": "/scripts/start-qemu.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus" : true,
                "panel": "dedicated",
            }
        },  
        { 
            "label": "(debug) Start Kernel in QEMU",
            "type": "shell",
            "command": "/scripts/debug-qemu.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus" : true,
                "panel": "dedicated",
            }
        },
        {
            "label": "(debug) Start GDB",
            "type": "shell",
            "command": "gdb-multiarch", 
            "problemMatcher": [],
            "args": [
                "/sources/linux/vmlinux",
            ],
            "presentation": {
                "reveal": "always",
                "focus" : true,
                "panel": "dedicated",
            }

        },
        {
            "label": "(Advanced) Use vscode to debug",
            "type": "shell",
            "command": "cp", 
            "problemMatcher": [],
            "args": [
                "/sources/.gdbinit_vscode",
                "/root/.gdbinit"
            ],
            "presentation": {
                "focus" : false,
            }

        },
        {
            "label": "(Advanced) Use gef to debug",
            "type": "shell",
            "command": "cp", 
            "problemMatcher": [],
            "args": [
                "/sources/.gdbinit_gef",
                "/root/.gdbinit"
            ],
            "presentation": {
                "focus" : false,
            }

        },
        {
            "label": "(Advanced) Generate compile_commands.json",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceRoot}/.vscode/generate_compdb.py"
            ],
            "problemMatcher": []
        }
    ]
}
